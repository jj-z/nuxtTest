# ============================================================
#  .env.example —— 环境变量参考模板
#
#  重要说明：
#  1. 本文件只是参考示例，不会被实际使用（已在 .dockerignore 中排除）
#  2. 实际环境变量在 docker-compose.yml 的 environment 字段中配置
#  3. 如果你想用本文件，复制为 .env 并在 docker-compose.yml 中用 env_file 引用
# ============================================================

# —— 数据库密码 ——
# docker-compose.yml 通过 ${DB_PASSWORD} 引用，复制本文件为 .env 后修改
# .env 已被 .gitignore 忽略，不会提交到仓库
DB_PASSWORD=你的数据库密码

# —— 数据库连接 ——
# 格式：postgresql://用户名:密码@主机:端口/数据库名?schema=public
# 主机填 db（docker-compose 中的服务名），端口填容器内部的 5432
DATABASE_URL=postgresql://nuxtuser:你的数据库密码@db:5432/nuxt_test?schema=public

# —— Nuxt 会话密钥 ——
# 用于加密用户登录会话的 cookie，必须是至少 32 位的随机字符串
# 生成方法：在终端运行  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NUXT_SESSION_PASSWORD=替换成至少32位随机字符串

# —— GLM 大模型 API 密钥 ——
# 智谱 AI 平台申请：https://open.bigmodel.cn/
# 不填则 AI 问答功能不可用，其他功能正常
NUXT_GLM_API_KEY=你的GLM_API密钥

# —— 文件上传目录 ——
# 容器内路径，对应 docker-compose.yml 中挂载的 volume
UPLOAD_DIR=/app/uploads
