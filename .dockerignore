# ============================================================
#  .dockerignore —— 告诉 Docker 构建时忽略哪些文件
#  作用：1. 减小镜像体积  2. 避免把本地环境文件误带进容器
#  语法和 .gitignore 类似
# ============================================================

# —— Node 依赖 ——
# 容器里会重新 npm install，不要把本机的 node_modules 带进去
# （本机可能是 Windows，原生模块二进制不兼容 Linux）
node_modules

# —— 构建产物 ——
# 容器里会重新 build，不要带本地构建产物
.output
.nuxt
.nitro
.cache
dist

# —— Prisma 生成代码 ——
# 容器里会重新 prisma generate
generated/prisma

# —— Git 相关 ——
.git
.gitignore

# —— 环境变量文件（含密钥，不能打进镜像）——
# 生产环境的密钥通过 docker-compose 的 environment 或 .env 注入
.env
.env.*
!.env.example

# —— 上传文件（运行时数据，用 volume 挂载持久化）——
uploads
app/uploads

# —— 日志 ——
logs
*.log
npm-debug.log*

# —— 编辑器 / IDE 配置 ——
.vscode
.idea
.fleet
.DS_Store

# —— 各类 AI 助手的配置目录（跟运行无关）——
.agents
.claude
.cursor
.devin
.trae
.trae-cn

# —— 测试文件 ——
*.test.*
*.spec.*
__tests__

# —— 文档（镜像里不需要）——
*.md
README.md
deploy-guide.md
